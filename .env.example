# HTTP
PORT=3000
HOSTNAME=0.0.0.0
PUBLIC_BASE_URL=https://mcp.evidiq.dev/atlas

# Dataset, request, and artifact limits
ATLAS_MAX_INLINE_BYTES=5242880
# Must be at least 2 * ATLAS_MAX_INLINE_BYTES + 2 MiB (default: 12582912).
ATLAS_MAX_REQUEST_BYTES=12582912
ATLAS_MAX_REMOTE_BYTES=26214400
ATLAS_MAX_QUERY_ROWS=1000
ATLAS_QUERY_TIMEOUT_MS=30000
ATLAS_ARTIFACT_DIR=/tmp/evidiq-atlas-artifacts

# Optional EIP-191 report signing/trust configuration.
# The private key signs reports. ATLAS_SIGNER_ADDRESS can configure a trusted
# verification address without signing; when both are set, they must match.
# ATLAS_SIGNER_PRIVATE_KEY=0x...
# ATLAS_SIGNER_ADDRESS=0x...

# Optional E2B provider metadata. Atlas remains fully functional with local DuckDB.
# ATLAS_SANDBOX_PROVIDER=e2b
# E2B_API_KEY=...

# Optional 0G Storage anchoring (best-effort)
# OG_PRIVATE_KEY=0x...
# OG_STORAGE_RPC=https://evmrpc.0g.ai
# OG_STORAGE_INDEXER=https://indexer-storage-turbo.0g.ai
# OG_CHAIN_ID=16661

# x402 payment (X Layer mainnet, USD₮0 — the OKX A2MCP settlement token).
# X402_CHAIN accepts a slug (x-layer) or a CAIP-2 id; X402_NETWORK is an alias.
# Atlas prices are fixed per tool (5000/10000/15000/20000/30000 atomic USD₮0),
# so there is no X402_PRICE to configure.
# X402_PAY_TO is the shared EVIDIQ seller wallet (same as Operator/Sentinel/Notary);
# comment it out to disable the gate and run every tool free.
X402_CHAIN=eip155:196
X402_ASSET=0x779ded0c9e1022225f8e0630b35a9b54be713736
X402_PAY_TO=0x2a8efe3093278bb4bd3b2d9c7b5ba992ca4fc9b0
X402_DOMAIN_NAME=USD₮0
X402_DOMAIN_VERSION=1
X402_FACILITATOR_URL=https://web3.okx.com
# X402_RPC (alias: X402_RPC_URL)
X402_RPC=https://rpc.xlayer.tech
# X402_USE_FACILITATOR=1
# X402_SETTLE_KEY=0x... (gas-funded X Layer wallet for direct settlement)
